# Copia este archivo a .env y completa los valores.
# Firebase Console -> Configuracion del proyecto -> Cuentas de servicio -> "Generar nueva clave privada"
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Entre comillas dobles y con los saltos de linea escritos como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firebase Console -> Configuracion del proyecto -> General -> "Clave de API web"
FIREBASE_WEB_API_KEY=AIzaSy...
